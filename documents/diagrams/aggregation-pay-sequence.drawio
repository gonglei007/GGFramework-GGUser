        <mxCell id="ll_game" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="90" y="76" as="sourcePoint" /><mxPoint x="90" y="686" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="ll_gg" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="250" y="76" as="sourcePoint" /><mxPoint x="250" y="686" as="targetPoint" /></mxGeometry>
