<mxfile host="app.diagrams.net" agent="GGUser" version="21.0.0">
  <diagram id="gguser-agg-pay" name="聚合支付时序">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="780" math="0" shadow="0">
